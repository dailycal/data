---
/** The layout of /staff and /staff/past: a title, an intro, groups of author cards and a footer. */
import PageLayout from "./PageLayout.astro";

interface Props {
  title: string;
  description: string;
  /** Show the title and intro (false keeps the title for screen readers only). */
  heading?: boolean;
}

const { title, description, heading = true } = Astro.props;
---

<PageLayout title={title} description={description}>
  <div class:list={["staff", { headless: !heading }]}>
    <header class:list={["pageHead", { hidden: !heading }]}>
      <p class="hud-label kicker">
        <span class="pulse-dot"></span>
        Personnel <span class="sep">//</span> Data desk
      </p>
      <h1>{title}</h1>
      {Astro.slots.has("intro") && (
        <p class="intro">
          <slot name="intro" />
        </p>
      )}
    </header>
    <slot />
    <p class="footer">
      <slot name="footer" />
    </p>
  </div>
</PageLayout>

<style>
  .staff {
    max-width: 1240px;
    margin: 0 auto;
    padding: 56px 20px 0;
    box-sizing: border-box;
    font-family: var(--dc-font-sans);
  }
  .kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
    color: var(--dc-text-dim);
  }
  .sep {
    color: var(--dc-accent);
  }
  h1 {
    margin: 0;
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--dc-text);
  }
  .headless {
    padding-top: 16px;
  }
  /* Read by screen readers, but not shown */
  .hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .intro {
    max-width: 560px;
    margin: 18px 0 8px;
    font-size: 17px;
    line-height: 1.55;
    color: var(--dc-text-dim);
  }
  .footer {
    margin: 40px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--dc-line);
  }
  .footer :global(a) {
    font-family: var(--dc-font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dc-accent);
    text-decoration: none;
  }
  .footer :global(a)::after {
    content: " →";
  }
  .footer :global(a:hover) {
    text-decoration: underline;
  }
  @media (max-width: 560px) {
    .staff {
      padding: 36px 12px 0;
    }
  }
</style>
