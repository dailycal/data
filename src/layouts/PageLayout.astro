---
/**
 * The layout every page renders into: <head> (see src/components/Head.astro), the fixed
 * header (a link to the staff page, the logo, and a link to search), and the page content.
 *
 * With ?embed in its URL (e.g. /article/x?embed, for embedding it in another site's page), a page
 * has no header, and its links to other pages on this site keep ?embed, so a reader who follows
 * them stays embedded.
 */
import { Image } from "astro:assets";
import wordmark from "../assets/site/dclogoblack.webp";
import Head, { type Props as HeadProps } from "../components/Head.astro";
import "../styles/global.css";

type Props = HeadProps;
---

<!doctype html>
<html lang="en">
  <head>
    <Head {...Astro.props} />
    {/* ?embed hides the header. The site is static, so this reads the URL in the browser, inline in
    <head> so it runs before the page is drawn and the header never shows. */}
    <script is:inline>
      if (new URLSearchParams(location.search).has("embed")) {
        document.documentElement.dataset.embed = "";

        // Adds ?embed to a link to another page on this site (not to a part of this page, or a file
        // to download), so following it stays embedded
        const keepEmbed = (link) => {
          const href = link.getAttribute("href");
          if (!href || href.startsWith("#") || link.hasAttribute("download")) {
            return;
          }
          const url = new URL(link.href);
          if (url.origin !== location.origin || url.searchParams.has("embed")) {
            return;
          }
          url.search = url.search ? `${url.search}&embed` : "?embed";
          link.setAttribute("href", url.pathname + url.search + url.hash);
        };
        // The page's links once it's loaded, and any added later (e.g. search results) as they're
        // tapped, clicked, middle-clicked or long-pressed, before the browser follows them
        document.addEventListener("DOMContentLoaded", () => {
          document.querySelectorAll("a[href]").forEach(keepEmbed);
        });
        for (const type of ["click", "auxclick", "contextmenu"]) {
          document.addEventListener(
            type,
            (event) => {
              const link = event.target instanceof Element && event.target.closest("a[href]");
              if (link) {
                keepEmbed(link);
              }
            },
            true,
          );
        }
      }
    </script>
  </head>
  <body>
    {/* Header */}
    <header class="header">
      <a href="/staff" class="staffLink">
        Staff
      </a>
      <a href="/" class="logoLink" aria-label="The Daily Californian: Data home">
        <Image
          src={wordmark}
          alt="The Daily Californian"
          class="logo"
          height={20}
          densities={[1, 2, 3]}
          loading="eager"
        />
      </a>
      <a href="/search" class="searchLink" aria-label="Search">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <circle
            cx="10.5"
            cy="10.5"
            r="6.5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          ></circle>
          <path
            d="M15.5 15.5 21 21"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          ></path>
        </svg>
      </a>
    </header>

    {/* Content */}
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  body {
    padding-top: 50px;
    background-color: var(--palette-light-gray);
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    box-sizing: border-box;
    margin: 0;
  }
  main {
    flex: 1;
    padding: 0 8px;
  }

  /* Embedded (?embed): no header, and no room left for it. The app or page around this one has its
     own header above it, so each page's content only needs a little room at the top: every page's
     top padding is var(--embed-top, <its own>), so it's this with ?embed and its own otherwise. */
  :global(html[data-embed]) {
    --embed-top: 12px;
  }
  :global(html[data-embed]) body {
    padding-top: 0;
  }
  :global(html[data-embed]) .header {
    display: none;
  }

  /* Header: logo centered */
  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 50px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: white;
    z-index: 9999;
    border-bottom: 1px solid #d3d3d3;
  }
  .logoLink {
    display: flex;
  }
  .logo {
    height: 20px;
    width: auto;
  }
  .searchLink {
    position: absolute;
    right: 16px;
    display: flex;
    padding: 6px;
    color: var(--palette-black);
  }
  .staffLink {
    position: absolute;
    left: 16px;
    padding: 6px;
    font-family: Georgia, sans-serif;
    font-size: 16px;
    color: var(--palette-black);
    text-decoration: none;
  }
  .searchLink:hover,
  .staffLink:hover {
    color: var(--palette-dark-blue);
  }
  /* Leaves room for the staff and search links on narrow phones */
  @media (max-width: 440px) {
    .logo {
      height: 16px;
    }
    .searchLink {
      right: 6px;
    }
    .staffLink {
      left: 6px;
      font-size: 14px;
    }
  }
  @media (max-width: 360px) {
    .logo {
      height: 13px;
    }
  }
</style>
