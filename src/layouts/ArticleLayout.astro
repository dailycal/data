---
/** The layout for articles (layout: true): header, title, hero image, byline, body and footer. */
import { Image } from "astro:assets";
import PageLayout from "./PageLayout.astro";
import StoryFooter from "../components/StoryFooter.astro";
import { type Article, articleHead, dateFormat, featuredImageAlt } from "../lib/articles";
import { bylinePath } from "../lib/authors";
import "../styles/article.css";
// The old site's base styles, which the visuals in older articles were designed for
import "../styles/legacy-typography.css";

interface Props {
  article: Article;
}

const { article } = Astro.props;
const {
  date,
  title,
  byline,
  featuredImage,
  secondaryFeaturedImage,
  imageAttribution,
  subhead,
  hideHeroImage,
  imageCaption,
  aboutStory,
  jointDept,
} = article.data;

const imageAlt = featuredImageAlt(article);
---

<PageLayout article={articleHead(article)}>
  <div class="article">
    <div class="centeredItems">
      {/* Header */}
      <h1 class="title">{title}</h1>
      {subhead && <h3 class="subhead">{subhead}</h3>}
      <h5 class="date">
        <time datetime={date.toISOString()}>{dateFormat.format(date)}</time>
      </h5>

      {/* Featured image */}
      {!hideHeroImage && (
        <div class="imageContainer">
          <Image
            src={secondaryFeaturedImage ?? featuredImage}
            alt={imageAlt}
            class="image"
            layout="constrained"
            width={640}
            loading="eager"
            fetchpriority="high"
          />

          {imageCaption && (
            <div class="imageCaption">
              <em class="caption">{imageCaption}</em>
            </div>
          )}

          {imageAttribution && <h5 class="imageAttribution">{imageAttribution}</h5>}
        </div>
      )}
    </div>

    {/* Byline, linking to each author's page (flatMap avoids whitespace between authors) */}
    <div class="byline">
      <span>By </span>
      {byline.flatMap((author: string, i: number) => {
        const path = bylinePath(author);
        return [
          ...(i > 0 ? [i === byline.length - 1 ? " & " : ", "] : []),
          path ? (
            <a href={path} class="link">
              {author}
            </a>
          ) : (
            author
          ),
        ];
      })}
    </div>

    {/* Article */}
    <article class="content">
      <slot />
    </article>

    {/* About story and Support us */}
    <StoryFooter aboutStory={aboutStory} jointDept={jointDept} />
  </div>
</PageLayout>

<style>
  .link {
    color: var(--palette-dark-blue);
  }
  .article {
    display: flex;
    flex-direction: column;
    padding: 30px 0;
    margin: 0 auto;
    max-width: 640px;
    font-family: Georgia, sans-serif;
  }
  /* Header */
  .centeredItems {
    width: 100%;
    align-items: center;
    display: flex;
    flex-direction: column;
  }
  .imageContainer .image {
    width: 100%;
    height: auto;
  }
  .imageContainer .caption,
  .imageContainer h5 {
    margin-top: 10px;
  }
  .byline {
    font-size: 15px;
    font-family: sans-serif;
    margin-bottom: 25px;
    width: 100%;
  }
  .caption {
    font-family: var(--font-list);
    color: var(--palette-dark-gray);
  }
  .title {
    font-weight: 600;
    font-size: 35px;
    line-height: normal;
    text-align: center;
  }
  .subhead {
    font-weight: 300;
    font-size: 24px;
    line-height: normal;
    margin-top: 0;
    color: var(--palette-dark-gray);
    font-family: var(--font-list);
    text-align: center;
  }
  .date {
    text-align: center;
  }
  .date,
  .imageAttribution {
    margin: 0 0 1.45rem 0;
    color: var(--palette-dark-gray);
    font-family: var(--font-list);
    font-weight: 500;
    font-size: 0.87055rem;
    line-height: 1.1;
  }
</style>
