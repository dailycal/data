---
/**
 * The homepage: the desk's readout (stories, years, contributors, latest story), a ticker of the
 * latest headlines, the newest story as the lead, then every other story by year, newest first.
 */
import ArticleCard from "../components/ArticleCard.astro";
import { site } from "../config/site";
import PageLayout from "../layouts/PageLayout.astro";
import { articlePath, dateFormat, getArticles } from "../lib/articles";
import { getAuthors } from "../lib/authors";

// Every article, newest first
const articles = await getArticles();
const authors = await getAuthors();
const [lead, ...rest] = articles;

// Each story's file number, counting from the oldest
const fileNumber = (i: number) => articles.length - i;

// The rest by year, newest year first
const years = [...new Set(rest.map((article) => article.data.date.getUTCFullYear()))];
const byYear = years.map((year) => ({
  year,
  stories: rest
    .map((article, i) => ({ article, number: fileNumber(i + 1) }))
    .filter(({ article }) => article.data.date.getUTCFullYear() === year),
}));
const allYears = articles.map((article) => article.data.date.getUTCFullYear());
const firstYear = Math.min(...allYears);
const lastYear = Math.max(...allYears);

// Stories per year, for the readout's chart: every year from the first to the last, even empty ones
const perYear = Array.from({ length: lastYear - firstYear + 1 }, (_, i) => {
  const year = firstYear + i;
  return { year, count: allYears.filter((y) => y === year).length };
});
const maxCount = Math.max(...perYear.map(({ count }) => count));
// Label only the busiest year and the latest one on the chart; the rest show on hover
const labeled = new Set([perYear.find(({ count }) => count === maxCount)!.year, lastYear]);
// A clean top for the axis: the next multiple of 10 at or above the busiest year
const axisMax = Math.ceil(maxCount / 10) * 10;
const sectionYears = new Set(years);

const stats = [
  { label: "Stories filed", value: String(articles.length) },
  { label: "Years on record", value: `${firstYear}–${String(lastYear).slice(2)}` },
  { label: "Contributors", value: String(authors.length) },
  {
    label: "Latest dispatch",
    value: lead.data.date.toISOString().slice(0, 10).replaceAll("-", "."),
  },
];

const ticker = articles.slice(0, 10);
const stamp = (date: Date) =>
  date.toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
---

<PageLayout>
  {/* Readout */}
  <section class="hero">
    <div class="heroInner">
      <p class="hud-label kicker">
        <span class="pulse-dot"></span>
        Data desk <span class="sep">//</span> The Daily Californian
      </p>
      <h1>
        Stories in <span class="gradient">the data.</span>
      </h1>
      <p class="tagline">{site.description}</p>

      {/* Stories per year: one column per year, linking to that year's stories */}
      <figure class="output">
        <figcaption>
          <span class="hud-label">Output</span>
          <span class="outputTitle">Stories published per year</span>
        </figcaption>
        <div class="plot">
          <div class="gridlines" aria-hidden="true">
            <span style="--at: 1">
              <b>{axisMax}</b>
            </span>
            <span style="--at: 0.5">
              <b>{axisMax / 2}</b>
            </span>
            <span style="--at: 0">
              <b>0</b>
            </span>
          </div>
          <ol class="columns">
            {perYear.map(({ year, count }, i) => {
              const label = `${year}: ${count} ${count === 1 ? "story" : "stories"}`;
              const Tag = sectionYears.has(year) || year === lastYear ? "a" : "span";
              return (
                <li style={`--h: ${count / axisMax}; --i: ${i}`}>
                  <Tag
                    class:list={["column", { labeled: labeled.has(year) }]}
                    href={Tag === "a" ? `#y${year}` : undefined}
                    role={Tag === "span" ? "img" : undefined}
                    aria-label={label}
                    title={label}
                  >
                    <span class="bar">
                      <span class="value">{count}</span>
                    </span>
                    <span class="tick">{`’${String(year).slice(2)}`}</span>
                  </Tag>
                </li>
              );
            })}
          </ol>
        </div>
      </figure>

      <dl class="stats">
        {stats.map(({ label, value }, i) => (
          <div class="stat" style={`--i: ${i}`}>
            <dt class="hud-label">{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* Ticker of the latest headlines (twice over, so it loops without a gap) */}
  <div class="ticker" aria-label="Latest headlines">
    <span class="tickerLabel">
      <span class="pulse-dot"></span>Latest
    </span>
    <div class="tickerViewport">
      <ul class="tickerTrack">
        {[0, 1].map((copy) =>
          ticker.map((article) => (
            <li aria-hidden={copy === 1 ? "true" : undefined}>
              <a href={articlePath(article)} tabindex={copy === 1 ? -1 : undefined}>
                <time datetime={article.data.date.toISOString()}>{stamp(article.data.date)}</time>
                {article.data.title}
              </a>
            </li>
          )),
        )}
      </ul>
    </div>
  </div>

  <div class="content">
    {/* Lead story */}
    <section class="leadSection" aria-labelledby="lead-heading">
      <h2 class="sectionHead" id="lead-heading">
        <span class="hud-label">Latest dispatch</span>
        <span class="rule"></span>
        <span class="hud-label count">{dateFormat.format(lead.data.date)}</span>
      </h2>
      <ArticleCard article={lead} eager lead number={fileNumber(0)} />
    </section>

    {/* Year index */}
    <nav class="yearIndex" aria-label="Jump to a year">
      <span class="hud-label">Archive</span>
      {byYear.map(({ year, stories }) => (
        <a href={`#y${year}`}>
          {year}
          <span>{String(stories.length).padStart(2, "0")}</span>
        </a>
      ))}
    </nav>

    {/* Every other story, by year */}
    {byYear.map(({ year, stories }, y) => (
      <section class="yearSection" id={`y${year}`} aria-labelledby={`y${year}-heading`}>
        <h2 class="sectionHead" id={`y${year}-heading`}>
          <span class="year">{year}</span>
          <span class="rule"></span>
          <span class="hud-label count">
            {stories.length} {stories.length === 1 ? "file" : "files"}
          </span>
        </h2>
        <div class="grid">
          {stories.map(({ article, number }, i) => (
            <ArticleCard article={article} eager={y === 0 && i < 3} number={number} />
          ))}
        </div>
      </section>
    ))}
  </div>
</PageLayout>

<style>
  /* Readout */
  .hero {
    position: relative;
    border-bottom: 1px solid var(--dc-line);
    overflow: hidden;
  }
  /* A slow-moving glow behind the headline */
  .hero::before {
    content: "";
    position: absolute;
    width: 720px;
    height: 720px;
    right: -180px;
    top: -380px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(76, 201, 255, 0.16),
      rgba(139, 123, 255, 0.08) 45%,
      transparent 70%
    );
    animation: drift 18s ease-in-out infinite alternate;
    pointer-events: none;
  }
  @keyframes drift {
    to {
      transform: translate(-120px, 80px);
    }
  }
  .heroInner {
    position: relative;
    max-width: 1240px;
    margin: 0 auto;
    padding: 72px 20px 48px;
    box-sizing: border-box;
  }
  /* Wide screens: the headline on the left, the chart on the right, the stats under both */
  @media (min-width: 1040px) {
    .heroInner {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      column-gap: 56px;
    }
    .kicker,
    h1,
    .tagline,
    .stats {
      grid-column: 1;
    }
    .output {
      grid-column: 2;
      grid-row: 1 / span 3;
      align-self: end;
      margin: 0 !important;
    }
    .stats {
      grid-column: 1 / -1;
    }
  }

  /* Stories-per-year chart */
  .output {
    margin: 40px 0 0;
    padding: 18px 20px 14px;
    border: 1px solid var(--dc-line);
    border-radius: 4px;
    background: rgba(13, 20, 33, 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .output figcaption {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 18px;
  }
  .output figcaption .hud-label {
    color: var(--dc-accent);
  }
  .outputTitle {
    font-size: 15px;
    font-weight: 500;
    color: var(--dc-text);
  }
  .plot {
    position: relative;
    height: 168px;
    margin-left: 26px;
  }
  /* Hairline gridlines, with their values in the left margin */
  .gridlines span {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(22px + var(--at) * (100% - 22px - 18px));
    height: 1px;
    background: rgba(130, 170, 230, 0.12);
  }
  .gridlines span:last-child {
    background: rgba(130, 170, 230, 0.32);
  }
  .gridlines b {
    position: absolute;
    right: calc(100% + 8px);
    top: -7px;
    font-family: var(--dc-font-mono);
    font-size: 10px;
    font-weight: 400;
    color: var(--dc-text-faint);
  }
  .columns {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: stretch;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .columns li {
    flex: 1;
    min-width: 0;
  }
  .column {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    height: 100%;
    padding-bottom: 22px;
    box-sizing: border-box;
    text-decoration: none;
    outline: none;
  }
  /* The column grows from the baseline, up to the axis top (18px below the plot's top) */
  .bar {
    position: relative;
    width: min(24px, 70%);
    height: calc(var(--h) * (100% - 18px));
    min-height: 1px;
    border-radius: 4px 4px 0 0;
    background: #1f95d4;
    transform-origin: bottom;
    animation: grow 900ms var(--dc-ease-out) both;
    animation-delay: calc(var(--i) * 45ms + 250ms);
    transition:
      background-color 200ms,
      box-shadow 200ms;
  }
  @keyframes grow {
    from {
      transform: scaleY(0);
    }
  }
  .column:hover .bar,
  .column:focus-visible .bar {
    background: var(--dc-accent);
    box-shadow: 0 0 18px var(--dc-accent-glow);
  }
  .value {
    position: absolute;
    bottom: calc(100% + 4px);
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--dc-font-mono);
    font-size: 11px;
    color: var(--dc-text);
    opacity: 0;
    transition: opacity 200ms;
    pointer-events: none;
  }
  .labeled .value,
  .column:hover .value,
  .column:focus-visible .value {
    opacity: 1;
  }
  .tick {
    position: absolute;
    bottom: 0;
    font-family: var(--dc-font-mono);
    font-size: 10px;
    color: var(--dc-text-faint);
    transition: color 200ms;
  }
  .column:hover .tick,
  .column:focus-visible .tick {
    color: var(--dc-text);
  }
  /* Narrow screens: every other year's label */
  @media (max-width: 520px) {
    .columns li:nth-child(even) .tick {
      visibility: hidden;
    }
    .columns li:nth-child(even) .column:hover .tick {
      visibility: visible;
    }
  }
  .kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 22px;
    color: var(--dc-text-dim);
  }
  .sep {
    color: var(--dc-accent);
  }
  h1 {
    margin: 0;
    max-width: 14ch;
    font-family: var(--dc-font-sans);
    font-size: clamp(44px, 7.4vw, 104px);
    font-weight: 650;
    line-height: 0.96;
    letter-spacing: -0.045em;
    color: var(--dc-text);
  }
  .gradient {
    white-space: nowrap;
    background: linear-gradient(100deg, var(--dc-accent) 10%, #a5b4ff 55%, var(--dc-violet) 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .tagline {
    max-width: 560px;
    margin: 24px 0 0;
    font-size: 18px;
    line-height: 1.55;
    color: var(--dc-text-dim);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 48px 0 0;
    border: 1px solid var(--dc-line);
    border-radius: 4px;
    background: rgba(10, 16, 27, 0.6);
    backdrop-filter: blur(8px);
  }
  .stat {
    position: relative;
    padding: 18px 20px 20px;
    border-left: 1px solid var(--dc-line);
    animation: rise 700ms var(--dc-ease-out) both;
    animation-delay: calc(var(--i) * 90ms + 150ms);
  }
  .stat:first-child {
    border-left: none;
  }
  .stat::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 20px;
    width: 28px;
    height: 2px;
    background: var(--dc-accent);
    box-shadow: 0 0 10px var(--dc-accent-glow);
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  .stat dd {
    margin: 10px 0 0;
    font-family: var(--dc-font-mono);
    font-size: clamp(22px, 2.6vw, 32px);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--dc-text);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 760px) {
    .heroInner {
      padding: 44px 16px 32px;
    }
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: 32px;
    }
    .stat:nth-child(3) {
      border-left: none;
    }
    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--dc-line);
    }
    .tagline {
      font-size: 16px;
    }
  }

  /* Ticker */
  .ticker {
    display: flex;
    align-items: stretch;
    height: 42px;
    border-bottom: 1px solid var(--dc-line);
    background: rgba(8, 12, 21, 0.85);
    overflow: hidden;
  }
  .tickerLabel {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 18px;
    flex-shrink: 0;
    border-right: 1px solid var(--dc-line);
    background: rgba(255, 77, 94, 0.08);
    color: #ff8a95;
    font-family: var(--dc-font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .tickerViewport {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 40px, black 92%, transparent);
  }
  .tickerTrack {
    display: flex;
    width: max-content;
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: ticker 90s linear infinite;
  }
  .ticker:hover .tickerTrack,
  .ticker:focus-within .tickerTrack {
    animation-play-state: paused;
  }
  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }
  .tickerTrack li {
    display: flex;
    align-items: center;
  }
  .tickerTrack a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 28px;
    white-space: nowrap;
    color: var(--dc-text-dim);
    font-size: 14px;
    text-decoration: none;
    border-right: 1px solid var(--dc-line);
    transition: color 200ms;
  }
  .tickerTrack a:hover {
    color: var(--dc-text);
  }
  .tickerTrack time {
    font-family: var(--dc-font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dc-accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .tickerViewport {
      overflow-x: auto;
    }
  }

  /* Stories */
  .content {
    max-width: 1240px;
    margin: 0 auto;
    padding: 40px 20px 0;
    box-sizing: border-box;
  }
  .sectionHead {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 0 0 20px;
    font-weight: inherit;
  }
  .sectionHead .hud-label:first-child {
    color: var(--dc-accent);
  }
  .rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, var(--dc-line-strong), var(--dc-line) 60%, transparent);
  }
  .count {
    flex-shrink: 0;
  }
  .year {
    font-family: var(--dc-font-mono);
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--dc-text);
  }

  .yearIndex {
    position: sticky;
    top: calc(var(--dc-header-height) + 10px);
    z-index: 10;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    width: fit-content;
    max-width: 100%;
    box-sizing: border-box;
    margin: 48px 0 8px;
    padding: 6px 6px 6px 14px;
    border: 1px solid var(--dc-line);
    border-radius: 6px;
    background: rgba(8, 12, 21, 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .yearIndex .hud-label {
    margin-right: 6px;
  }
  .yearIndex a {
    display: flex;
    align-items: baseline;
    gap: 6px;
    padding: 5px 10px;
    border-radius: 4px;
    font-family: var(--dc-font-mono);
    font-size: 13px;
    color: var(--dc-text);
    text-decoration: none;
    transition: background-color 200ms;
  }
  .yearIndex a span {
    font-size: 10px;
    color: var(--dc-text-faint);
  }
  .yearIndex a:hover {
    background: var(--dc-accent-soft);
  }

  .yearSection {
    padding-top: 40px;
    scroll-margin-top: calc(var(--dc-header-height) + 64px);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 20px;
  }
  @media (max-width: 560px) {
    .content {
      padding: 28px 12px 0;
    }
    .yearIndex {
      position: static;
    }
  }
</style>
