---
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout
  title="Page Not Found"
  description="The page you're looking for couldn't be found."
  noindex
>
  <div class="notFound">
    <p class="hud-label kicker">
      <span class="pulse-dot"></span>Error 404 <span class="sep">//</span> No signal
    </p>
    <h1 data-text="404">404</h1>
    <p class="message">The page you're looking for doesn't exist or has moved.</p>
    <nav aria-label="Where to go instead">
      <a href="/">Back to stories →</a>
      <a href="/search">Search the archive →</a>
    </nav>
  </div>
</PageLayout>

<style>
  .notFound {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 96px 16px 40px;
    text-align: center;
    font-family: var(--dc-font-sans);
  }
  .kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    color: #ff8a95;
  }
  .sep {
    color: var(--dc-text-faint);
  }
  /* A glitching readout: two offset copies of the number flicker in and out */
  h1 {
    position: relative;
    margin: 12px 0 8px;
    font-family: var(--dc-font-mono);
    font-size: clamp(110px, 22vw, 220px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.06em;
    color: var(--dc-text);
    text-shadow: 0 0 40px rgba(76, 201, 255, 0.35);
  }
  h1::before,
  h1::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  h1::before {
    color: var(--dc-accent);
    mix-blend-mode: screen;
    animation: glitch 3.2s infinite steps(1);
  }
  h1::after {
    color: var(--dc-live);
    mix-blend-mode: screen;
    animation: glitch 3.2s infinite steps(1) reverse;
  }
  @keyframes glitch {
    0%,
    86%,
    100% {
      transform: none;
      clip-path: inset(0 0 100% 0);
    }
    88% {
      transform: translateX(-6px);
      clip-path: inset(20% 0 55% 0);
    }
    91% {
      transform: translateX(5px);
      clip-path: inset(60% 0 12% 0);
    }
    94% {
      transform: translateX(-3px);
      clip-path: inset(38% 0 40% 0);
    }
  }
  .message {
    margin: 0;
    font-size: 18px;
    color: var(--dc-text-dim);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 36px;
  }
  a {
    padding: 10px 16px;
    border: 1px solid var(--dc-line-strong);
    border-radius: 4px;
    font-family: var(--dc-font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dc-accent);
    text-decoration: none;
    transition:
      background-color 200ms,
      border-color 200ms;
  }
  a:hover {
    border-color: var(--dc-accent);
    background: var(--dc-accent-soft);
  }
</style>
