---
/**
 * Search: /search?q=<query>. Searches every article's title, subhead, byline and text in the
 * browser, with the index src/lib/search-index.mjs builds into dist/pagefind/ (so it only works in
 * the built site, not `npm run dev`).
 */
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout title="Search" description="Search The Daily Californian Data Team's stories." noindex>
  <div class="search">
    <p class="hud-label kicker">
      <span class="pulse-dot"></span>
      Archive query <span class="sep">//</span> Every story on the desk
    </p>
    <h1>Search</h1>
    <form action="/search" role="search">
      <span class="prompt" aria-hidden="true">
        &gt;
      </span>
      <input
        type="search"
        name="q"
        aria-label="Search stories"
        placeholder="Search stories"
        autocomplete="off"
        spellcheck="false"
      />
      <button type="submit">
        Run <span aria-hidden="true">↵</span>
      </button>
    </form>
    <noscript>
      <p class="status">Search needs JavaScript.</p>
    </noscript>
    <p class="status" aria-live="polite"></p>
    <ol class="results"></ol>
    <button type="button" class="more" hidden>
      More results
    </button>
  </div>
</PageLayout>

<script>
  // The parts of Pagefind's browser API this page uses
  interface ResultData {
    /** The record's text: its title, byline, then the rest, as words separated by spaces */
    content: string;
    meta: Record<string, string>;
    /** Positions (in content's words) of the words that matched */
    locations: number[];
  }
  interface Pagefind {
    options(options: object): Promise<void>;
    init(): Promise<void>;
    debouncedSearch(
      query: string,
      options?: object,
      ms?: number,
    ): Promise<{ results: { data(): Promise<ResultData> }[] } | null>;
  }

  const PAGE_SIZE = 10;
  const EXCERPT_WORDS = 40;

  const form = document.querySelector<HTMLFormElement>(".search form")!;
  const input = form.querySelector<HTMLInputElement>("input")!;
  const status = document.querySelector<HTMLElement>(".search > .status")!;
  const list = document.querySelector<HTMLOListElement>(".search .results")!;
  const more = document.querySelector<HTMLButtonElement>(".search .more")!;

  let pagefind: Promise<Pagefind> | undefined;
  function loadPagefind(): Promise<Pagefind> {
    pagefind ??= import(/* @vite-ignore */ "/pagefind/pagefind.js").then(
      async (module: Pagefind) => {
        await module.init();
        return module;
      },
    );
    return pagefind;
  }

  let results: { data(): Promise<ResultData> }[] = [];
  let shown = 0;
  // Each search gets a number, so a slow one that finishes after a newer one is dropped
  let latest = 0;

  const wordsOf = (text = "") => text.split(/\s+/).filter(Boolean);

  /**
   * The passage shown with a result: EXCERPT_WORDS words of its text, with the matching words in
   * <mark>. Each record's text starts with its title and byline, so they're searched, but they're
   * already shown above the passage, so it's taken from after them: around the most matches there,
   * or from the start of the text if only the title or byline matched. (Pagefind's own excerpt
   * would show the title whenever it matched.)
   */
  function excerpt({ content, meta, locations }: ResultData): Node[] {
    const words = content.split(" ");
    const start = wordsOf(meta.title).length + wordsOf(meta.byline).length;
    const matches = new Set(locations.filter((at) => at >= start));
    let from = start;
    let best = 0;
    for (const at of matches) {
      // A few words before the match, but still a full passage when it's near the end
      const windowStart = Math.max(start, Math.min(at - 5, words.length - EXCERPT_WORDS));
      let count = 0;
      for (const other of matches) {
        if (other >= windowStart && other < windowStart + EXCERPT_WORDS) count++;
      }
      if (count > best) [from, best] = [windowStart, count];
    }

    const nodes: Node[] = [];
    let text = "";
    for (let at = from; at < Math.min(words.length, from + EXCERPT_WORDS); at++) {
      if (matches.has(at)) {
        nodes.push(document.createTextNode(text));
        text = "";
        const mark = document.createElement("mark");
        mark.textContent = words[at];
        nodes.push(mark, document.createTextNode(" "));
      } else {
        text += `${words[at]} `;
      }
    }
    nodes.push(document.createTextNode(text.trimEnd()));
    return nodes;
  }

  /** One result: the card's image, then date, title and the matching passage. */
  function render(data: ResultData): HTMLLIElement {
    const { meta } = data;
    const item = document.createElement("li");
    const link = document.createElement("a");
    link.className = "result";
    link.href = meta.href;

    const image = document.createElement("img");
    Object.assign(image, {
      src: meta.image,
      srcset: meta.image_srcset,
      alt: meta.image_alt,
      loading: "lazy",
    });
    image.style.objectPosition = meta.image_position;

    const text = document.createElement("div");
    const date = document.createElement("span");
    date.className = "date";
    date.textContent = meta.date;
    const title = document.createElement("span");
    title.className = "title";
    title.textContent = meta.title;
    const passage = document.createElement("p");
    passage.className = "excerpt";
    passage.append(...excerpt(data));
    text.append(date, title);
    // An article with no text but its title and byline has no passage
    if (passage.textContent) text.append(passage);

    link.append(image, text);
    item.append(link);
    return item;
  }

  async function showMore(search: number) {
    const page = await Promise.all(
      results.slice(shown, shown + PAGE_SIZE).map((result) => result.data()),
    );
    if (search !== latest) return;
    list.append(...page.map(render));
    shown += page.length;
    more.hidden = shown >= results.length;
  }

  async function run(query: string, wait = 150) {
    const search = ++latest;
    const url = query.trim() ? `?${new URLSearchParams({ q: query })}` : location.pathname;
    history.replaceState(null, "", url);

    if (!query.trim()) {
      results = [];
      list.replaceChildren();
      status.textContent = "";
      more.hidden = true;
      return;
    }

    let found;
    try {
      found = await (await loadPagefind()).debouncedSearch(query, {}, wait);
    } catch {
      status.textContent = import.meta.env.DEV
        ? "Search only works in the built site: run npm run build, then npx wrangler dev."
        : "Search couldn't load. Try reloading the page.";
      return;
    }
    // null: a newer search replaced this one while it waited
    if (!found || search !== latest) return;

    results = found.results;
    shown = 0;
    list.replaceChildren();
    const count = results.length;
    status.textContent = count
      ? `${count} ${count === 1 ? "result" : "results"} for “${query.trim()}”`
      : `No results for “${query.trim()}”`;
    await showMore(search);
  }

  input.addEventListener("input", () => run(input.value));
  form.addEventListener("submit", (event) => {
    event.preventDefault();
    run(input.value, 0);
  });
  more.addEventListener("click", () => showMore(latest));

  // /search?q=...: search for it right away
  const query = new URLSearchParams(location.search).get("q") ?? "";
  input.value = query;
  if (query.trim()) {
    run(query, 0);
  } else {
    input.focus();
    // Start loading the index while they type (a failure is reported when they search)
    loadPagefind().catch(() => undefined);
  }
</script>

<style>
  .search {
    max-width: 880px;
    margin: 0 auto;
    padding: 56px 20px 0;
    box-sizing: border-box;
    font-family: var(--dc-font-sans);
    color: var(--dc-text);
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
    color: var(--dc-text-dim);
  }
  .sep {
    color: var(--dc-accent);
  }

  h1 {
    margin: 0 0 28px;
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--dc-text);
  }

  /* The query line: a prompt, the input and the run button, in one console field */
  form {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 6px 6px 18px;
    border: 1px solid var(--dc-line-strong);
    border-radius: 6px;
    background: rgba(10, 16, 27, 0.85);
    box-shadow:
      0 0 0 4px rgba(76, 201, 255, 0.04),
      0 20px 50px -24px rgba(0, 0, 0, 0.9);
    transition:
      border-color 200ms,
      box-shadow 200ms;
  }
  form:focus-within {
    border-color: var(--dc-accent);
    box-shadow:
      0 0 0 4px rgba(76, 201, 255, 0.12),
      0 0 40px -10px var(--dc-accent-glow);
  }
  .prompt {
    font-family: var(--dc-font-mono);
    font-size: 20px;
    color: var(--dc-accent);
    animation: blink 1.2s steps(2, start) infinite;
  }
  form:focus-within .prompt {
    animation: none;
  }
  @keyframes blink {
    to {
      opacity: 0.25;
    }
  }

  input {
    flex: 1;
    min-width: 0;
    height: 48px;
    padding: 0 4px;
    border: none;
    border-radius: 0;
    background: transparent;
    color: var(--dc-text);
    font-family: var(--dc-font-mono);
    font-size: 18px;
    caret-color: var(--dc-accent);
  }
  input::placeholder {
    color: var(--dc-text-faint);
  }
  input:focus {
    outline: none;
  }
  input::-webkit-search-cancel-button {
    filter: invert(1) brightness(0.8);
  }

  button {
    height: 44px;
    padding: 0 18px;
    border: 1px solid var(--dc-accent);
    border-radius: 4px;
    background: var(--dc-accent-soft);
    color: var(--dc-accent);
    font-family: var(--dc-font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color 200ms,
      color 200ms;
  }
  button:hover {
    background: var(--dc-accent);
    color: var(--dc-bg);
  }
  button:focus-visible {
    outline: 2px solid var(--dc-accent);
    outline-offset: 2px;
  }

  .status {
    min-height: 1.4em;
    margin: 18px 0 8px;
    font-family: var(--dc-font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dc-text-dim);
  }
  .status:not(:empty)::before {
    content: "// ";
    color: var(--dc-accent);
  }

  .results {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* The results are added by the script, so their styles can't be scoped to this file */
  .results :global(.result) {
    display: flex;
    gap: 20px;
    margin-top: 12px;
    padding: 14px;
    border: 1px solid var(--dc-line);
    border-radius: 4px;
    background: linear-gradient(180deg, rgba(16, 24, 40, 0.7), rgba(9, 14, 24, 0.7));
    color: inherit;
    text-decoration: none;
    transition:
      border-color 200ms,
      transform 300ms var(--dc-ease-out);
  }
  .results :global(.result:hover) {
    border-color: var(--dc-line-strong);
    transform: translateX(4px);
  }

  .results :global(.result img) {
    flex-shrink: 0;
    align-self: flex-start;
    width: 200px;
    height: auto;
    aspect-ratio: 360 / 200;
    object-fit: cover;
    border-radius: 2px;
  }

  .results :global(.date) {
    display: block;
    margin-bottom: 8px;
    font-family: var(--dc-font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dc-accent);
  }

  .results :global(.title) {
    display: block;
    font-size: 19px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--dc-text);
  }

  .results :global(.excerpt) {
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--dc-text-dim);
  }

  .results :global(mark) {
    padding: 0 2px;
    border-radius: 2px;
    background: rgba(76, 201, 255, 0.2);
    box-shadow: inset 0 -1px 0 var(--dc-accent);
    color: var(--dc-text);
  }

  .more {
    display: block;
    margin: 24px auto 0;
  }

  .more[hidden] {
    display: none;
  }

  @media (max-width: 560px) {
    .search {
      padding: 36px 12px 0;
    }
    form {
      padding-left: 12px;
    }
    input {
      font-size: 16px;
    }
    button {
      padding: 0 12px;
    }
    .results :global(.result) {
      gap: 12px;
      padding: 10px;
    }
    .results :global(.result img) {
      width: 104px;
    }
    .results :global(.title) {
      font-size: 16px;
    }
  }
</style>
