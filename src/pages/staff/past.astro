---
/**
 * /staff/past: everyone with an author file or a byline who isn't on the team now, grouped by the
 * year of their first article.
 */
import AuthorCard from "../../components/AuthorCard.astro";
import AuthorGroup from "../../components/AuthorGroup.astro";
import StaffLayout from "../../layouts/StaffLayout.astro";
import { getAuthors, pastTeam } from "../../lib/authors";

const groups = pastTeam(await getAuthors());
---

<StaffLayout
  title="Past Data contributors"
  description="The Daily Californian Data Team's past members and contributors."
>
  <Fragment slot="intro">
    Past members and contributors of the Data Department, by the year of their first story.
  </Fragment>
  {groups.map(({ year, authors }, g) => (
    <AuthorGroup title={year ? String(year) : "No articles"} count={authors.length}>
      {authors.map((author, i) => (
        <AuthorCard author={author} eager={g === 0 && i < 5} />
      ))}
    </AuthorGroup>
  ))}
  <Fragment slot="footer">
    <a href="/staff">Current staff</a>
  </Fragment>
</StaffLayout>
