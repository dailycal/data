---
/** A linked card for an author (picture, name, role and story count), used on /staff and /staff/past. */
import AuthorPicture from "./AuthorPicture.astro";
import { type Author, EDITOR_ROLE_LABELS, authorPath } from "../lib/authors";

interface Props {
  author: Author;
  /** Load the picture eagerly (for cards visible without scrolling). */
  eager?: boolean;
}

const { author, eager } = Astro.props;
// Editors without an author file are labeled with their role on the team
const role = author.entry?.data.role ?? (author.teamRole && EDITOR_ROLE_LABELS[author.teamRole]);
const stories = author.articles.length;
---

<a href={authorPath(author.slug)} class="authorCard">
  <span class="ring">
    <AuthorPicture author={author} size={112} eager={eager} />
  </span>
  <span class="name">{author.name}</span>
  {role && <span class="role">{role}</span>}
  <span class="stories hud-label">
    {stories > 0
      ? `${String(stories).padStart(2, "0")} ${stories === 1 ? "story" : "stories"}`
      : "—"}
  </span>
</a>

<style>
  .authorCard {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 24px 14px 16px;
    border: 1px solid var(--dc-line);
    border-radius: 4px;
    background: linear-gradient(180deg, rgba(16, 24, 40, 0.75), rgba(9, 14, 24, 0.75));
    font-family: var(--dc-font-sans);
    text-align: center;
    text-decoration: none;
    transition:
      border-color 250ms,
      transform 300ms var(--dc-ease-out),
      box-shadow 300ms;
  }
  .authorCard:hover,
  .authorCard:focus-visible {
    border-color: var(--dc-line-strong);
    transform: translateY(-3px);
    box-shadow:
      0 18px 40px -18px rgba(0, 0, 0, 0.9),
      0 0 32px -8px rgba(76, 201, 255, 0.25);
  }
  .authorCard:focus-visible {
    outline: 2px solid var(--dc-accent);
    outline-offset: 2px;
  }
  /* A ring around the picture that lights up on hover */
  .ring {
    display: flex;
    padding: 3px;
    margin-bottom: 8px;
    border-radius: 50%;
    background: conic-gradient(
      from 210deg,
      var(--dc-line-strong),
      transparent 40%,
      var(--dc-line-strong)
    );
    transition: background 300ms;
  }
  .authorCard:hover .ring {
    background: conic-gradient(
      from 210deg,
      var(--dc-accent),
      var(--dc-violet),
      transparent 70%,
      var(--dc-accent)
    );
  }
  .ring :global(.picture) {
    border: 3px solid var(--dc-bg);
  }
  .name {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--dc-text);
  }
  .role {
    font-size: 13px;
    line-height: 1.35;
    color: var(--dc-text-dim);
  }
  .stories {
    margin-top: auto;
    padding-top: 10px;
    font-size: 10px;
  }
</style>
