---
/** A grid of author cards, under an optional heading, used on /staff and /staff/past. */
interface Props {
  title?: string;
  /** How many cards it has, shown beside the heading. */
  count?: number;
}

const { title, count } = Astro.props;
---

<section class="authorGroup">
  {title && (
    <h2>
      <span class="name">{title}</span>
      <span class="rule"></span>
      {count !== undefined && (
        <span class="hud-label">
          {String(count).padStart(2, "0")} {count === 1 ? "person" : "people"}
        </span>
      )}
    </h2>
  )}
  <div class="cards">
    <slot />
  </div>
</section>

<style>
  .authorGroup {
    width: 100%;
    margin-top: 40px;
  }
  h2 {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 0 0 20px;
    font-weight: inherit;
  }
  .name {
    font-family: var(--dc-font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dc-accent);
  }
  .rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, var(--dc-line-strong), var(--dc-line) 60%, transparent);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
    gap: 16px;
  }
</style>
